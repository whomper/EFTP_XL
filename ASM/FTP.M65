;
; FTP.M65 - EFTP_XL 1.3
; FTP over FujiNet TCP connections
; Copyright (C) 2026 AERA | Erez Yaary
;
; Commands on N1:, passive data on
; N2:, plain TCP: firmware 1.3 on.
; (FujiNet's own FTP is anonymous on
; port 21 only, up to 1.6.1.)
;
; F routines: C=1 on error, A=EOPEN,
; ETIME, ECLOSED or EREPLY (FTPMSG
; has the server's reply)
;
; NETCALL - SIO call to N1:/N2:
; A=command, Y=DSTATS ($40 in, $80
; out), CONN, NBUF/NLEN=buffer
; AUX: 'O' 12 (read and write), 'R'
; and 'W' the byte count, else 0
; Exit: C=1 failed
;
NETCALL  STA DCOMND         ; O S R W or C
         STY DSTATS
         LDA CONN
         CLC
         ADC #$71           ; N1: is $71
         STA DDEVIC
         LDA #1
         STA DUNIT
         LDA #$0F           ; 15 s timeout
         STA DTIMLO
         LDA NBUF
         STA DBUFLO
         LDA NBUF+1
         STA DBUFHI
         LDA NLEN
         STA DBYTLO
         LDA NLEN+1
         STA DBYTHI
         LDX #0             ; AUX1/AUX2
         LDY #0
         LDA DCOMND
         CMP #'O
         BNE NETC1
         LDX #12            ; read and write
NETC1    CMP #'R
         BEQ NETC2
         CMP #'W
         BNE NETC3
NETC2    LDX NLEN           ; how many
         LDY NLEN+1
NETC3    STX DAUX1
         STY DAUX2
         JSR SIOV           ; Y=SIO status
         CPY #128           ; C=1: SIO error
         RTS
;
; NSETB - NBUF=A/Y, NLEN=X
; (more than 255: set NLEN+1 after)
;
NSETB    STA NBUF
         STY NBUF+1
         STX NLEN
         LDA #0
         STA NLEN+1
         RTS
;
; NSTATUS - CONN's status into NSTAT:
; bytes waiting (2), connected, error
;
NSTATUS  LDA #<NSTAT
         LDY #>NSTAT
         LDX #4
         JSR NSETB
         LDA #'S
         LDY #$40
         JMP NETCALL
;
; NCLOSE - close CONN
; NREAD, NWRITE - NLEN bytes at NBUF
; DCLOSE - close N2:
;
NCLOSE   LDX #0             ; no data
         JSR NSETB
         LDA #'C
         LDY #0
         JMP NETCALL
NREAD    LDA #'R
         LDY #$40
         JMP NETCALL
NWRITE   LDA #'W
         LDY #$80
         JMP NETCALL
DCLOSE   LDA #1
         STA CONN
         BNE NCLOSE         ; always
;
; CONOPEN - open CONN to HOST,
; A/Y=port: "N1:TCP://HOST:PORT"
; The spec goes out 0-padded in SPEC
; Exit: C=1 failed
;
CONOPEN  STA PTR3           ; port (SBADD uses PTR)
         STY PTR3+1
         LDA #0
         TAX
CONO1    STA SPEC,X         ; 256 bytes, zeroed
         INX
         BNE CONO1
         LDA #<SPEC
         LDY #>SPEC
         JSR SBSTART
         LDA #'N
         JSR SBCH
         LDA CONN
         CLC
         ADC #'1            ; "1" or "2"
         JSR SBCH
         JSR SBI
         .BYTE ":TCP://",0
         LDA #<HOST
         LDY #>HOST
         JSR SBADD
         LDA #':
         JSR SBCH
         LDA PTR3
         LDY PTR3+1
         JSR SBADD
         LDX CONN
         LDA #0             ; its buffer empty
         STA CPOS,X
         STA CLEN,X
         LDA #<SPEC
         LDY #>SPEC
         LDX #0             ; X was CONN:
         JSR NSETB          ; N2: sent 257
         INC NLEN+1         ; NLEN=256
         LDA #'O
         LDY #$80
         JMP NETCALL
;
; TSTART - start the clock: T0=now
;
TSTART   LDA RTCLOK+2       ; low byte
         STA T0
         LDA RTCLOK+1
         STA T0+1
         RTS
;
; TIMEUP - C=1 when TOUT ticks have
; gone since TSTART (60 a second,
; 50 on PAL)
;
TIMEUP   LDA RTCLOK+2       ; YX = now - T0
         SEC
         SBC T0
         TAX
         LDA RTCLOK+1
         SBC T0+1
         TAY
         CPX TOUT           ; YX >= TOUT?
         TYA                ; CPX's C is the borrow
         SBC TOUT+1
         RTS
;
; GETC - next byte from CONN, through
; its 128-byte buffer
; Exit: A=byte; C=1 on error, A=ETIME
;       or ECLOSED
;
GETC     LDX CONN
         LDA CPOS,X
         CMP CLEN,X
         BCS GETC1          ; buffer empty
         INC CPOS,X
         TAY                ; Y=the old CPOS
         JSR CBUFP
         LDA (PTR3),Y
         CLC
         RTS
;
; Empty: wait up to TOUT for bytes,
; then read up to 128 into CBUF
;
GETC1    JSR TSTART
GETC2    JSR NSTATUS
         BCS GETC5
         LDA NSTAT          ; bytes waiting?
         ORA NSTAT+1
         BNE GETC3
         LDA NSTAT+2        ; connected?
         BEQ GETC5
         JSR TIMEUP
         BCC GETC2
         LDA #ETIME
         RTS
GETC3    LDA NSTAT          ; at most 128
         LDX NSTAT+1
         BNE GETC4          ; 256 or more
         CMP #128
         BCC GETC4A
GETC4    LDA #128
GETC4A   LDX CONN
         STA CLEN,X         ; bytes it will hold
         PHA
         LDA #0
         STA CPOS,X
         JSR CBUFP
         PLA
         TAX                ; X=count, for NSETB
         LDA PTR3
         LDY PTR3+1
         JSR NSETB
         JSR NREAD
         BCC GETC           ; now take one
GETC5    LDA #ECLOSED       ; SIO failed or closed
         SEC
         RTS
;
; CBUFP - PTR3=buffer of connection X
; (CBUF0 for N1:, CBUF1 for N2:)
;
CBUFP    LDA CBUFL,X
         STA PTR3
         LDA CBUFH,X
         STA PTR3+1
         RTS
CBUFL    .BYTE <CBUF0,<CBUF1
CBUFH    .BYTE >CBUF0,>CBUF1
;
; GETS - line from CONN, no CR LF
; A/Y=buffer, X=its size with the 0
; (the rest of a long line is lost)
; Exit: C=1 on error, A=code; a last
;       line without LF is kept
;
GETS     STA PTR2
         STY PTR2+1
         STX GMAX
         LDA #0
         STA GLEN           ; bytes kept
GETS1    JSR GETC
         BCS GETS3
         CMP #10            ; LF: end
         BEQ GETS2
         CMP #13            ; CR: skip
         BEQ GETS1
         LDY GLEN
         INY                ; room for it and 0?
         CPY GMAX
         BCS GETS1          ; full: drop it
         DEY
         STA (PTR2),Y
         INC GLEN
         BNE GETS1          ; always
GETS2    LDY GLEN
         LDA #0
         STA (PTR2),Y
         CLC
         RTS
GETS3    PHA                ; the error code
         JSR GETS2          ; 0-end what came
         PLA
         CMP #ECLOSED
         BNE GETS4
         LDY GLEN           ; closed after text?
         BNE GETS5
GETS4    SEC                ; CMP may clear C
         RTS
GETS5    CLC
         RTS
;
; REPLY - the server's reply on N1:,
; all lines of a long one
; Exit: FTPMSG=its last line, RCHI=
;       1st digit, RCLO=other two
;       (as BCD: 257 is 2 and $57)
;       C=1 on error, A=code
;
REPLY    LDA #0
         STA CONN
         LDA #<FTPMSG
         LDY #>FTPMSG
         LDX #80            ; FTPMSG's size
         JSR GETS
         BCS REPLY9
         LDA FTPMSG
         CMP #'1            ; 1xx to 5xx only
         BCC REPLYX
         CMP #'6
         BCS REPLYX
         LDA FTPMSG+1       ; 3 characters at least
         BEQ REPLYX
         LDA FTPMSG+2
         BEQ REPLYX
         LDA FTPMSG+3
         CMP #'-            ; "220-": more lines
         BNE REPLY4
;
; A long reply ends with a line of
; the same code and a space
;
REPLY1   LDA #<FLINE        ; up to "220 ..."
         LDY #>FLINE
         LDX #160
         JSR GETS
         BCS REPLY9
         LDX #2
REPLY2   LDA FLINE,X        ; same code?
         CMP FTPMSG,X
         BNE REPLY1
         DEX
         BPL REPLY2
         LDA FLINE+3
         CMP #32
         BNE REPLY1         ; "220-" again: on
         LDX #0
REPLY3   LDA FLINE,X        ; into FTPMSG
         STA FTPMSG,X
         BEQ REPLY4
         INX
         CPX #79
         BNE REPLY3
         LDA #0             ; cut at 79 and 0
         STA FTPMSG,X
REPLY4   LDA FTPMSG+1       ; digits to BCD
         ASL A
         ASL A
         ASL A
         ASL A              ; "5" ($35) is now $50
         STA RCLO
         LDA FTPMSG+2
         AND #$0F           ; "7" is 7
         ORA RCLO
         STA RCLO
         LDA FTPMSG
         AND #$0F
         STA RCHI
         CLC
         RTS
REPLYX   LDA #EREPLY        ; not a reply line
         SEC
REPLY9   RTS
;
; RCIS - was the reply X (1st digit),
; A (the others: $20 for 220)?
; Exit: Z=1 when so
;
RCIS     CPX RCHI
         BNE RCIS1
         CMP RCLO
RCIS1    RTS
;
; SEND - command A/Y, then ARGP if
; ARGP+1 is not 0; then its REPLY
; SEND0 - the same, no argument
; Builds "VERB arg" CR LF in CMDB
; Exit: as REPLY
;
SEND0    LDX #0
         STX ARGP+1
SEND     PHA                ; keep A/Y over SBSTART
         TYA
         PHA
         LDA #<CMDB
         LDY #>CMDB
         JSR SBSTART
         PLA
         TAY
         PLA
         JSR SBADD
         LDA ARGP+1
         BEQ SEND1
         JSR SBSP
         LDA ARGP
         LDY ARGP+1
         JSR SBADD
SEND1    LDA #13            ; CR LF
         JSR SBCH
         LDA #10
         JSR SBCH
         LDA #0             ; on N1:
         STA CONN
         LDA SBP            ; its length
         SEC
         SBC #<CMDB         ; under 256 bytes
         TAX
         LDA #<CMDB
         LDY #>CMDB
         JSR NSETB
         JSR NWRITE
         BCS FCLOSED
         JMP REPLY
FCLOSED  LDA #ECLOSED       ; C still 1
         RTS
;
; FNO - the server said no: EREPLY
; FOK - all well: C=0
;
FNO      LDA #EREPLY
         SEC
         RTS
FOK      CLC
         RTS
;
; MSGI - FTPMSG=string after the JSR
; (our own message for the error)
;
MSGI     JSR INLINE         ; A/Y=the string
         LDX #<FTPMSG
         STX PTR2
         LDX #>FTPMSG
         STX PTR2+1
         JMP STRCPY
;
; FCONN - connect to HOST, wait for
; 220; A/Y=port ("": 21)
; Exit: C=1, A=EOPEN or code
;
FCONN    STA PTR
         STY PTR+1
         LDY #0
         LDA (PTR),Y
         BNE FCONN1         ; a port given
         LDA #<P21
         LDY #>P21
         BNE FCONN2         ; always
FCONN1   LDA PTR
         LDY PTR+1
FCONN2   LDX #0             ; N1:
         STX CONN
         JSR CONOPEN
         BCC FCONN3
         JSR MSGI
         .BYTE "Could not connect.",0
         LDA #EOPEN
         SEC
         RTS
FCONN3   JSR REPLY          ; the welcome
         BCS FCONN4
         LDX #2
         LDA #$20           ; 220: ready
         JSR RCIS
         BNE FNO
         CLC
FCONN4   RTS
P21      .BYTE "21",0
;
; FLOGIN - USER A/Y ("": anonymous),
; PASS from PASSW, then TYPE I
; Exit: C=1 on error, A=code
;
FLOGIN   STA ARGP
         STY ARGP+1
         LDY #0
         LDA (ARGP),Y
         BNE FLOG1
         LDA #<ANON
         STA ARGP
         LDA #>ANON
         STA ARGP+1
FLOG1    LDA #<VUSER
         LDY #>VUSER
         JSR SEND
         BCS FLOG9
         LDX #3
         LDA #$31           ; 331: needs PASS
         JSR RCIS
         BNE FLOG2          ; no PASS asked for
         LDA #<PASSW
         STA ARGP
         LDA #>PASSW
         STA ARGP+1
         LDA #<VPASS
         LDY #>VPASS
         JSR SEND
         BCS FLOG9
FLOG2    LDX #2             ; to USER or PASS
         LDA #$30           ; 230: logged in
         JSR RCIS
         BNE FNO2
         LDA #<TYPEI
         STA ARGP
         LDA #>TYPEI
         STA ARGP+1
         LDA #<VTYPE
         LDY #>VTYPE
         JSR SEND
         BCS FLOG9
         LDX #2
         LDA #0             ; 200
         JSR RCIS
         BNE FNO2
         CLC
FLOG9    RTS
FNO2     LDA #EREPLY        ; FNO, in branch reach
         SEC
         RTS
;
; FDO - command A/Y with ARGP;
; a 2xx or 3xx reply is all well
; Exit: C=1 on error, A=code
;
FDO      JSR SEND
         BCS FDO9
         LDA RCHI
         CMP #2
         BCC FNO2           ; 1xx
         CMP #4
         BCS FNO2           ; 4xx, 5xx
         CLC
FDO9     RTS
;
; FCWD - CWD to the folder A/Y
;
FCWD     STA ARGP
         STY ARGP+1
         LDA #<VCWD
         LDY #>VCWD
         JMP FDO
;
; FPWD - the server's folder into
; PATH1: 257 "/pub/atari" is ...
;
FPWD     LDA #<VPWD
         LDY #>VPWD
         JSR SEND0
         BCS FPWD9
         LDX #2
         LDA #$57           ; 257
         JSR RCIS
         BNE FNO2
         LDA #<FTPMSG
         STA PTR
         LDA #>FTPMSG
         STA PTR+1
         LDA #$22           ; to the first quote
         JSR FINDCH
         BCS FNO2
         LDY #1             ; past it
         LDX #0             ; X: into PATH1
FPWD1    LDA (PTR),Y
         BEQ FNO2           ; no closing quote
         CMP #$22           ; closing quote
         BEQ FPWD2
         STA PATH1,X
         INY
         INX
         CPX #PATHLEN-1     ; full: cut it
         BNE FPWD1
FPWD2    LDA #0
         STA PATH1,X
         CLC
FPWD9    RTS
;
; PASV - passive mode, the data port
; into DPORT. EPSV first:
; 229 ... (|||6446|), else PASV:
; 227 ... (h1,h2,h3,h4,p1,p2)
; (the data goes to HOST all the same)
;
PASV0    RTS                ; for BCS reach
PASV     LDA #<VEPSV
         LDY #>VEPSV
         JSR SEND0
         BCS PASV0
         LDX #2
         LDA #$29           ; 229
         JSR RCIS
         BNE PASV1          ; no: try PASV
         LDA #<FTPMSG
         STA PTR3
         LDA #>FTPMSG
         STA PTR3+1
         JSR STRSTRI        ; PTR3 on "|||"
         .BYTE "|||",0
         BCS PASV1
         LDA PTR3           ; PTR past it
         CLC
         ADC #3
         STA PTR
         LDA PTR3+1
         ADC #0
         STA PTR+1
         JSR ATOL           ; the port
         JMP PASV6
;
; PASV: PTR on to h1, past the "("
; or at the first digit after 227
;
PASV1    LDA #<VPASV
         LDY #>VPASV
         JSR SEND0
         BCS PASV9
         LDX #2
         LDA #$27           ; 227
         JSR RCIS
         BNE PASVNO
         LDA #<FTPMSG
         STA PTR
         LDA #>FTPMSG
         STA PTR+1
         LDA #'(
         JSR FINDCH
         BCS PASV2          ; PTR is at the 0
         JSR INCPTR
         JMP PASV4
PASV2    LDA #<[FTPMSG+4]   ; no "(": 1st digit
         STA PTR
         LDA #>[FTPMSG+4]
         STA PTR+1
PASV3    LDY #0
         LDA (PTR),Y
         BEQ PASV4          ; end: PASV5 says no
         JSR ISDIG
         BCS PASV4
         JSR INCPTR
         JMP PASV3
PASV4    LDA #4             ; past h1,h2,h3,h4
         STA PCOMMA         ; commas to pass
PASV5    LDA #',
         JSR FINDCH
         BCS PASVNO
         JSR INCPTR
         DEC PCOMMA
         BNE PASV5
         JSR ATOL           ; p1
         LDA NUM
         STA PHI
         LDA #',
         JSR FINDCH         ; ATOL left PTR on it
         BCS PASVNO
         JSR INCPTR
         JSR ATOL           ; p2
         LDA PHI            ; NUM=p1*256+p2
         STA NUM+1
PASV6    LDA #<DPORT        ; DPORT=NUM in digits
         LDY #>DPORT
         JSR SBSTART
         JSR SBNUM
         CLC
PASV9    RTS
PASVNO   JMP FNO            ; FNO is out of reach
;
; DOPEN - PASV, open N2:, then the
; command A/Y with ARGP: LIST, RETR
; or STOR
; Exit: C=0 data on its way (1xx);
;       C=1, A=code, N2: closed
;
DOPEN    STA DVERB
         STY DVERB+1
         LDA ARGP           ; SEND0 clears it
         STA DARG
         LDA ARGP+1
         STA DARG+1
         JSR PASV
         BCS DOPEN9
         LDA #1             ; N2:
         STA CONN
         LDA #<DPORT
         LDY #>DPORT
         JSR CONOPEN
         BCC DOPEN1
         JSR MSGI
         .BYTE "Could not open data connection.",0
         LDA #EOPEN
         SEC
         RTS
DOPEN1   LDA DARG
         STA ARGP
         LDA DARG+1
         STA ARGP+1
         LDA DVERB
         LDY DVERB+1
         JSR SEND
         BCS DOPEN2         ; A=the error
         LDA RCHI           ; 1xx: data coming
         CMP #1
         BNE DOPEN1A
         CLC
         RTS
DOPEN1A  LDA #EREPLY
DOPEN2   PHA                ; close N2:
         JSR DCLOSE
         PLA
         SEC
DOPEN9   RTS
;
; FLIST - LIST the folder, RADD for
; each line
; Exit: as FDONE
;
FLIST    LDA #0             ; no argument
         STA ARGP+1
         LDA #<VLIST
         LDY #>VLIST
         JSR DOPEN
         BCS DOPEN9
FLIST1   LDA #1             ; N2:, each line
         STA CONN
         LDA #<FLINE
         LDY #>FLINE
         LDX #160
         JSR GETS
         BCC FLIST2
         JMP FDONE          ; end of the list
FLIST2   LDA FLINE          ; skip empty lines
         BEQ FLIST1
         JSR RADD
         JMP FLIST1
;
; FRETR, FSTOR - start getting or
; sending the file A/Y; through the
; gateway TYPE A first for a text
; file (eftpgate turns the line ends
; for SFTP), TYPE I for the others
; Exit: as DOPEN
;
FRETR    STA ARGP
         STY ARGP+1
         LDA #<VRETR
         LDY #>VRETR
         JMP FXFER
FSTOR    STA ARGP
         STY ARGP+1
         LDA #<VSTOR
         LDY #>VSTOR
FXFER    LDX GWAY
         BEQ FXFER2         ; FTP: as it is
         STA DVERB          ; kept over TYPE
         STY DVERB+1
         LDA ARGP
         STA DARG
         LDA ARGP+1
         STA DARG+1
         LDA #<TYPEI
         LDY #>TYPEI
         LDX XTEXT
         BEQ FXFER1
         LDA #<TYPEA
         LDY #>TYPEA
FXFER1   STA ARGP
         STY ARGP+1
         LDA #<VTYPE
         LDY #>VTYPE
         JSR FDO
         BCS FXFER3
         LDA DARG
         STA ARGP
         LDA DARG+1
         STA ARGP+1
         LDA DVERB
         LDY DVERB+1
FXFER2   JMP DOPEN
FXFER3   RTS
;
; FREAD - what has come of the file
; into BUF, 512 bytes at most
; Exit: NLEN=bytes, 0 at its end;
;       C=1, A=ETIME or ECLOSED
;
FREAD    JSR TSTART
FREAD1   LDA #1
         STA CONN
         JSR NSTATUS
         BCS FREAD9
         LDA NSTAT          ; bytes waiting?
         ORA NSTAT+1
         BNE FREAD3
         LDA NSTAT+2        ; connected?
         BEQ FREAD2         ; no, all read: end
         JSR TIMEUP
         BCC FREAD1
         LDA #ETIME
         RTS
FREAD2   STA NLEN           ; closed: the end
         STA NLEN+1
         CLC
         RTS
FREAD3   LDA NSTAT
         LDX NSTAT+1
         CPX #2             ; 512 at most
         BCC FREAD4
         LDA #0             ; XA=$0200
         LDX #2
FREAD4   STX TMP            ; high byte
         TAX
         LDA #<BUF
         LDY #>BUF
         JSR NSETB
         LDA TMP
         STA NLEN+1
         JSR NREAD
         BCC FREAD5
FREAD9   JMP FCLOSED1
FREAD5   RTS
FCLOSED1 LDA #ECLOSED
         SEC
         RTS
;
; FWRITE - XLEN bytes of BUF to N2:
; Exit: C=1, A=ECLOSED failed
;
FWRITE   LDA #1
         STA CONN
         LDA #<BUF
         LDY #>BUF
         LDX XLEN
         JSR NSETB
         LDA XLEN+1
         STA NLEN+1
         JSR NWRITE
         BCS FCLOSED1
         RTS
;
; FDONE - a file's end: close N2:,
; then 226 or 250
; Exit: C=1 on error, A=code
;
FDONE    JSR DCLOSE
         JSR REPLY
         BCS FDONE9
         LDX #2
         LDA #$26           ; 226: done
         JSR RCIS
         BEQ FDONE8
         LDA #$50           ; 250 (X still 2)
         JSR RCIS
         BEQ FDONE8
         JMP FNO
FDONE8   CLC
FDONE9   RTS
;
; FABORT - stop a file early: close
; N2:, then read the server's 426 (at
; times 226 too) for 2 s, so it isn't
; taken for the next reply; then on
; into FTOUT
;
FABORT   JSR DCLOSE
         LDA #121           ; 2 s
         STA TOUT
         LDA #0
         STA TOUT+1
FABORT1  JSR REPLY          ; until none comes
         BCC FABORT1
;
; FTOUT - TOUT back to 20 s
;
FTOUT    LDA #<1201         ; 20 seconds
         STA TOUT
         LDA #>1201
         STA TOUT+1
         RTS
;
; FQUIT - QUIT, then close N1:
;
FQUIT    LDA #<VQUIT
         LDY #>VQUIT
         JSR SEND0          ; any reply will do
         LDA #0
         STA CONN
         JMP NCLOSE
;
VUSER    .BYTE "USER",0
VPASS    .BYTE "PASS",0
VTYPE    .BYTE "TYPE",0
VCWD     .BYTE "CWD",0
VPWD     .BYTE "PWD",0
VEPSV    .BYTE "EPSV",0
VPASV    .BYTE "PASV",0
VLIST    .BYTE "LIST",0
VRETR    .BYTE "RETR",0
VSTOR    .BYTE "STOR",0
VQUIT    .BYTE "QUIT",0
ANON     .BYTE "anonymous",0
TYPEI    .BYTE "I",0        ; binary
TYPEA    .BYTE "A",0        ; text
