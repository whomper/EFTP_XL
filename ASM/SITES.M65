;
; SITES.M65 - EFTP_XL 1.5
; The Sites screen and EFTPXL.CFG
; Copyright (C) 2026 AERA | Erez Yaary
;
SITESZ   =   160        ; bytes SREC holds
SPOOLSZ  =   640        ; the sites' lines
SMODE    =   158        ; its mode
SPROTO   =   159        ; its protocol
SLROW    =   4          ; the list
SEPROW   =   SLROW+MAXSITES ; line under it
FROW     =   SEPROW+1   ; the fields
LABCOL   =   SCRL+2     ; their labels
VALCOL   =   SCRL+13    ; and values,
VALW     =   SCRR-VALCOL ; this wide
;
; Field offsets and sizes (with 0):
; name, server, port, user, password,
; server folder, Atari folder
;
FOFF     .BYTE 0,16,48,54,74,94,134
FSIZE    .BYTE 16,32,6,20,20,40,24
;
; The sites are kept as their lines
; of EFTPXL.CFG, each with its 0, one
; after the other in SPOOL (SPEND:
; the end); SSEL unpacks one into
; SREC, in the fields above
;
; SLINEX - PTR3 = site X's line
;
SLINEX   LDA #<SPOOL
         STA PTR3
         LDA #>SPOOL
         STA PTR3+1
SLINEX1  DEX                ; X lines to skip
         BMI SLINEX3
SLINEX2  LDY #0
         LDA (PTR3),Y
         INC PTR3
         BNE SLINEX4
         INC PTR3+1
SLINEX4  TAY                ; Z: it was the 0
         BNE SLINEX2
         BEQ SLINEX1        ; always
SLINEX3  RTS
;
; SSEL - SITEP = SREC, site X
; unpacked from its line; X at
; SCOUNT or more: a new one, all 0
; Exit: PTR, PTR3 changed
;
SSEL     JSR SCLEAR
         CPX SCOUNT
         BCS SLINEX3        ; new: blank
         JSR SLINEX
         LDA PTR3
         STA PTR
         LDA PTR3+1
         STA PTR+1
;
; The 7 fields, each to its '|':
; "Home|ftp.x.org|21|erez||/|D1:|0"
; then the mode, and "|1" or "|2"
; for SFTP or FTPS (none: FTP)
; PTR walks the line, TMP is where
; in the site, TMP2 the room left
;
         LDA #0
         STA SFI
SSEL2    LDX SFI            ; next field
         CPX #7
         BEQ SSEL6          ; all 7: the mode
         LDA FOFF,X
         STA TMP            ; where it goes
         LDA FSIZE,X
         STA TMP2
         DEC TMP2           ; room left, less 0
SSEL3    LDY #0
         LDA (PTR),Y
         BEQ SSEL8          ; ended early: kept
         CMP #'|
         BEQ SSEL5
         LDX TMP2
         BEQ SSEL4          ; full: drop it
         DEC TMP2
         LDY TMP
         STA (SITEP),Y      ; its 0 is there
         INC TMP            ; from SCLEAR
SSEL4    JSR INCPTR
         JMP SSEL3
SSEL5    JSR INCPTR         ; past the '|'
         INC SFI
         JMP SSEL2
SSEL6    LDY #0             ; mode digit
         LDA (PTR),Y
         BEQ SSEL8          ; none: binary
         AND #$0F           ; '0'-'2' to 0-2
         CMP #MODETYPE+1
         BCC SSEL7
         LDA #MODEBIN       ; bad: binary
SSEL7    LDY #SMODE
         STA (SITEP),Y
         LDY #1             ; "|" and the
         LDA (PTR),Y        ; protocol, if
         CMP #'|            ; there
         BNE SSEL8
         INY
         LDA (PTR),Y
         AND #$0F
         CMP #PROFTPS+1
         BCS SSEL8          ; bad: FTP
         LDY #SPROTO
         STA (SITEP),Y
SSEL8    RTS
;
; SFIELD - A/Y = field X of SITEP
;
SFIELD   LDA FOFF,X
         CLC
         ADC SITEP
         PHA                ; low byte kept
         LDA SITEP+1
         ADC #0             ; carry to the high
         TAY
         PLA
         RTS
;
; SCLEAR - SREC all 0, SITEP on it
; Exit: X kept
;
SCLEAR   LDA #<SREC
         STA SITEP
         LDA #>SREC
         STA SITEP+1
         LDY #0
         TYA                ; A = 0 too
SCLEAR1  STA (SITEP),Y
         INY
         CPY #SITESZ
         BNE SCLEAR1
         RTS
;
; SPACK - BUF = SITEP as a line: the
; 7 fields, a '|' after each, then
; the mode digit, and "|" and the
; protocol's if it isn't FTP
;
SPACK    LDA #<BUF
         LDY #>BUF
         JSR SBSTART
         LDA #0
         STA SFI
SPACK1   LDX SFI            ; field, then '|'
         JSR SFIELD
         JSR SBADD
         LDA #'|
         JSR SBCH
         INC SFI
         LDA SFI
         CMP #7
         BNE SPACK1
         LDY #SMODE
         LDA (SITEP),Y
         ORA #'0            ; mode as a digit
         JSR SBCH
         LDY #SPROTO        ; FTP: nothing, so
         LDA (SITEP),Y      ; the line is as
         BEQ SPACK2         ; 1.3 wrote it
         PHA
         LDA #'|
         JSR SBCH
         PLA
         ORA #'0
         JMP SBCH
SPACK2   RTS
;
; SLOAD - read the sites from
; D:EFTPXL.CFG into SPOOL, a line
; each (empty lines and notes, ;,
; skipped), and the gateway, @, into
; GW; D: is the DOS's current drive
; Exit: SCOUNT = sites read
;
SLOAD    LDA #0
         STA SCOUNT
         STA GW             ; no gateway yet
         LDA #'@            ; for SSAVE
         STA GWAT
         LDA #<SPOOL
         STA SPEND
         LDA #>SPOOL
         STA SPEND+1
         LDA #<CFG
         LDY #>CFG
         LDX #4             ; read
         JSR COPEN
         BCS SLOAD9         ; no file: no sites
SLOAD1   LDA SCOUNT
         CMP #MAXSITES
         BEQ SLOAD9         ; full
;
; X = the room left in SPOOL, 255
; at most; a line too long for it
; ends the reading (CIO: 137)
;
         LDA #<[SPOOL+SPOOLSZ]
         SEC
         SBC SPEND
         TAX
         LDA #>[SPOOL+SPOOLSZ]
         SBC SPEND+1
         BEQ SLOAD2         ; under 256
         LDX #255
SLOAD2   CPX #8
         BCC SLOAD9         ; no room
         LDA SPEND
         LDY SPEND+1
         JSR CGETLN         ; Y = its length
         BCS SLOAD9         ; end of file
         STY TMP
         TYA
         BEQ SLOAD1         ; empty: dropped
         LDY #0
         LDA (PTR),Y
         CMP #';
         BEQ SLOAD1         ; a note: dropped
         CMP #'@
         BEQ SLOADG         ; the gateway
         LDA SPEND          ; kept: SPEND past
         SEC                ; it and its 0
         ADC TMP
         STA SPEND
         BCC SLOAD3
         INC SPEND+1
SLOAD3   INC SCOUNT
         BNE SLOAD1         ; always
SLOAD9   JMP CCLOSE
;
; "@10.0.0.5:2121": all after the @
; into GW, cut to fit
;
SLOADG   LDX #0
         LDY #1
SLOADG1  LDA (PTR),Y
         STA GW,X
         BEQ SLOADG2        ; its 0 copied
         INY
         INX
         CPX #GWLEN-1
         BCC SLOADG1
         LDA #0             ; too long: cut
         STA GW,X
SLOADG2  JMP SLOAD1
;
; SSAVE - write the sites to the file,
; after the note on what it is, with
; site SEDI changed: A=0 BUF in its
; place (SEDI=SCOUNT: added at the
; end), A=$80 left out (deleted)
; Exit: C=1 on error, A=CIO code
;
SSAVE    STA SOP
         LDA #<CFG
         LDY #>CFG
         LDX #8             ; write: a new file
         JSR COPEN
         BCS SSAVE5
         LDA #CFGNOTEN      ; the note first
         STA XLEN
         LDA #0
         STA XLEN+1
         LDA #<CFGNOTE
         LDY #>CFGNOTE
         JSR CWRITE
         BCS SSAVE5
         LDA GW             ; then the gateway,
         BEQ SSAVE0         ; if there is one
         LDA #<GWAT
         LDY #>GWAT
         JSR CPUTLN
         BCS SSAVE5
SSAVE0   LDA #<SPOOL        ; PTR3 walks SPOOL
         STA PTR3           ; (CPUTLN takes PTR)
         LDA #>SPOOL
         STA PTR3+1
         LDA #0
         STA SSI
SSAVE1   LDA SSI            ; next site
         CMP SEDI
         BNE SSAVE2
         BIT SOP            ; the one changed
         BMI SSAVE3         ; deleted: left out
         LDA #<BUF          ; the new line
         LDY #>BUF
         JSR CPUTLN
         BCS SSAVE5
         BCC SSAVE3         ; always
SSAVE2   CMP SCOUNT
         BCS SSAVE4         ; all written
         LDA PTR3           ; as it was
         LDY PTR3+1
         JSR CPUTLN
         BCS SSAVE5
SSAVE3   LDA SSI
         CMP SCOUNT
         BCS SSAVE4         ; added: the last
         LDX #1             ; PTR3 to the next
         JSR SLINEX1
         INC SSI
         JMP SSAVE1
SSAVE4   JMP CCLOSE         ; C from the CLOSE
SSAVE5   PHA                ; keep the error
         JSR CCLOSE
         PLA
         SEC
         RTS
;
; SROOM - does BUF fit in SPOOL as
; site SEDI (over its old line)?
; Exit: C=1 it fits
;
SROOM    LDA #<BUF          ; TMP/TMP2 = SPEND
         LDY #>BUF          ; + the new line
         JSR STRLEN         ; and its 0
         SEC
         ADC SPEND
         STA TMP
         LDA SPEND+1
         ADC #0
         STA TMP2
         LDX SEDI
         CPX SCOUNT
         BCS SROOM1         ; a new one
         JSR SLINEX         ; less the old line
         LDA PTR3
         LDY PTR3+1
         JSR STRLEN
         STA TMP3
         LDA TMP            ; C=0: less 1 more,
         CLC                ; for its 0
         SBC TMP3
         STA TMP
         LDA TMP2
         SBC #0
         STA TMP2
SROOM1   LDA #<[SPOOL+SPOOLSZ]
         CMP TMP            ; 16-bit compare:
         LDA #>[SPOOL+SPOOLSZ]
         SBC TMP2           ; C=1: the end fits
         RTS
;
; The note at the top of EFTPXL.CFG:
; lines that start with ; are skipped
;
CFGNOTE  .BYTE "; EFTPXL.CFG - EFTP_XL's sites",EOL
         .BYTE "; name|server|port|user|password|",EOL
         .BYTE "; folder|Atari folder|mode|protocol",EOL
         .BYTE "; @: the Pi gateway, address:port",EOL
         .BYTE "; a password here is plain text",EOL
CFGNOTEN =   *-CFGNOTE
;
; SSAVEUI - SSAVE (A as for SSAVE),
; then SPOOL as the file now is
; (SMEM); on error the sites read
; again, it said, and a key waited
;
SSAVEUI  JSR SSAVE
         BCS SSAVEU2
         JMP SMEM           ; saved
SSAVEU2  STA FERR           ; the CIO code
         JSR SLOAD          ; as the file is
         JSR MSGSTART
         JSR SBI
         .BYTE "Could not save ",0
         LDA #<CFG
         LDY #>CFG
         JSR SBADD
         JSR SBI
         .BYTE ": error ",0
         LDA FERR
         JSR SBBYTE
         JSR INFOMSG
         JMP KEYGET
;
;
; SHMODE - the three choices of
; field X, 7 the Files: mode, 8 the
; protocol; choice A in inverse
;
SHMODE   STA SMD
         LDA #<MODES
         LDY #>MODES
         CPX #8
         BNE SHMODE0
         LDA #<PROTS
         LDY #>PROTS
SHMODE0  STA PTR3
         STY PTR3+1
         TXA                ; its row
         CLC
         ADC #FROW
         TAX
         LDY #VALCOL
         JSR AT
         LDA #0
         STA SMI            ; mode drawn
SHMODE1  LDA SMI
         CMP SMD
         BNE SHMODE2
         JSR INVON          ; the chosen one
SHMODE2  JSR KEYB2          ; name, PTR3 on
         JSR INVOFF
         INC SCOL           ; a column between
         INC SMI
         LDA SMI
         CMP #3
         BNE SHMODE1
         RTS
;
; SHFLD - show the fields of SITEP
; A=0: all blank, labels too
; Row FROW+n: label n at LABCOL in
; 10 columns, value at VALCOL
;
SHFLD    STA SHS
         LDA #<LABELS
         STA PTR3
         LDA #>LABELS
         STA PTR3+1
         LDA #0
         STA SFI
SHFLD1   LDA SFI            ; next row
         CLC
         ADC #FROW
         TAX
         LDY #LABCOL
         JSR AT
         LDA #10            ; label width
         STA SW
         LDA #<NOTHING      ; blank: spaces
         LDY #>NOTHING
         LDX SHS
         BEQ SHFLD2
         LDA PTR3
         LDY PTR3+1
SHFLD2   JSR PUTW           ; the label
         LDA PTR3
         LDY PTR3+1
         JSR STRLEN
         SEC                ; +1, its 0
         ADC PTR3           ; PTR3 to next label
         STA PTR3
         BCC SHFLD3
         INC PTR3+1
SHFLD3   JSR SHFAT
         LDA #VALW
         STA SW
         JSR SPACES         ; clear the value
         LDA SHS
         BEQ SHFLD6
         LDX SFI
         CPX #7
         BCC SHFLD4
         TXA                ; rows 7, 8: the
         CLC                ; mode, protocol
         ADC #SMODE-7
         TAY
         LDA PTR3+1         ; the labels'
         PHA                ; place kept
         LDA PTR3
         PHA
         LDA (SITEP),Y
         JSR SHMODE         ; walks PTR3
         PLA
         STA PTR3
         PLA
         STA PTR3+1
         JMP SHFLD6
SHFLD4   JSR SHFAT
         LDX SFI
         JSR SFIELD
         LDX SFI
         CPX #4
         BNE SHFLD5
         JSR STRLEN         ; password: a * each
         CMP #VALW
         BCC SHFLD4A
         LDA #VALW          ; VALW at most
SHFLD4A  STA SW
         LDA #'*
         JSR REP
         JMP SHFLD6
SHFLD5   JSR PUTW
SHFLD6   INC SFI
         LDA SFI
         CMP #9             ; 7, the 2 choices
         BEQ SHFLD6A
         JMP SHFLD1
SHFLD6A  LDA SHS
         BEQ SHFLD7
         LDX #4
         JSR SFIELD
         JSR STRLEN
         BNE SHFLD7         ; has a password
         LDX #FROW+4
         LDY #VALCOL
         JSR AT
         JSR PUTSI
         .BYTE "(asked for)",0
SHFLD7   RTS
;
; SHFAT - AT the value of field SFI
;
SHFAT    LDA SFI
         CLC
         ADC #FROW
         TAX
         LDY #VALCOL
         JMP AT
;
; SHLIST - the site list, A=cursor,
; and the fields of that site
;
SHLIST   STA SCUR2
         LDA #0
         STA SLI
SHLIST1  LDA SLI            ; next row
         CLC
         ADC #SLROW
         TAX
         LDY #SCRL+1        ; inside the box
         JSR AT
         LDA #SCRW-2
         STA SW
         JSR SPACES         ; clear the row
         LDA SLI
         CMP SCOUNT
         BCS SHLIST3        ; no site here
         LDA SLI
         CLC
         ADC #SLROW
         TAX
         LDY #SCRL+2
         JSR AT
         LDA SLI
         CMP SCUR2
         BNE SHLIST2
         JSR INVON          ; the cursor
SHLIST2  JSR PUTSP          ; " name", a bar
         LDA #SCRW-5        ; when inverse
         STA SW
         LDX SLI
         JSR SSEL
         LDA SITEP
         LDY SITEP+1
         JSR PUTW           ; its name
         JSR INVOFF
SHLIST3  INC SLI
         LDA SLI
         CMP #MAXSITES
         BNE SHLIST1
         LDA SCOUNT
         BNE SHLIST4
         LDX #SLROW+1       ; none: some help
         JSR SHLAT
         JSR PUTSI
         .BYTE "No sites yet.",0
         LDX #SLROW+3
         JSR SHLAT
         JSR PUTSI
         .BYTE "^N adds one: a name, the",0
         LDX #SLROW+4
         JSR SHLAT
         JSR PUTSI
         .BYTE "server, your user and the",0
         LDX #SLROW+5
         JSR SHLAT
         JSR PUTSI
         .BYTE "folders to start in.",0
         LDA #0             ; and blank fields
         JMP SHFLD
SHLIST4  LDX SCUR2          ; the cursor's
         JSR SSEL           ; site's fields
         LDA #1
         JMP SHFLD
SHLAT    LDY #SCRL+3        ; help: row X
         JMP AT
;
; SFRAME - the box, with a line
; under the list
;
SFRAME   LDX #2
         JSR RULE
         LDA #<STITLE
         LDY #>STITLE
         JSR BOX
         LDX #SEPROW        ; a tee each end
         LDY #SCRL
         JSR AT
         LDA #CHLT
         JSR PUTCH
         LDA #SCRW-2
         STA SW
         LDA #CHHLINE
         JSR REP
         LDA #CHRT
         JMP PUTCH
;
; SEDIT - edit site X (SCOUNT: a new
; one) in SREC: its line in SPOOL
; stays as it was until it is saved,
; so ESC leaves it so
; Exit: C=1 to save, BUF = its line;
;       C=0 left with ESC, or no room
;
SEDIT    STX SEDI
         JSR SSEL
         LDA #<EKEYS
         LDY #>EKEYS
         JSR KEYBAR
         LDA #1
         JSR SHFLD
         LDA #0
         STA SFI
;
; Field SFI: 0-6 typed in by EDIT,
; 7 the mode and 8 the protocol, by
; keys; then the key that ended it
; says where to go
;
SEDIT1   LDA SFI            ; field SFI
         CMP #7
         BCS SEDIT5         ; the mode
         CMP #4
         BNE SEDIT2
         JSR INFOI
         .BYTE "Blank: asked for when connecting",0
         JMP SEDIT3
SEDIT2   JSR INFOI
         .BYTE "Type, then RETURN for the next one",0
SEDIT3   LDX SFI
         LDA FSIZE,X        ; its size, with 0
         STA EDMAX
         LDA #0
         CPX #4
         BNE SEDIT4
         LDA #1             ; password: *s
SEDIT4   STA EDMASK
         JSR SHFAT
         LDA #VALW
         STA SW
         LDX SFI
         JSR SFIELD
         JSR EDIT           ; A=key it ended on
         LDX #0             ; LDX: A kept
         STX EDMASK
         JMP SEDIT6
;
; The choices: SPACE or right is the
; next, left the one before (+2,
; mod 3); others as after EDIT
;
SEDIT5   CMP #8
         BEQ SEDIT5C
         JSR INFOI
         .BYTE "SPACE changes, RETURN: the next",0
         JMP SEDIT5D
SEDIT5C  JSR INFOI
         .BYTE "SPACE changes, RETURN saves",0
SEDIT5D  JSR KEYGET
         LDX #1             ; next mode
         CMP #32
         BEQ SEDIT5A
         CMP #KRIGHT
         BEQ SEDIT5A
         LDX #2             ; +2: the one before
         CMP #KLEFT
         BNE SEDIT6
SEDIT5A  STX TMP
         LDA SFI            ; its byte: the
         CLC                ; mode's, or the
         ADC #SMODE-7       ; protocol's
         TAY
         LDA (SITEP),Y
         CLC
         ADC TMP
         CMP #3             ; mod 3
         BCC SEDIT5B
         SBC #3             ; C=1 here
SEDIT5B  STA (SITEP),Y
         LDX SFI
         JSR SHMODE
         JMP SEDIT1
SEDITJ   JMP SEDIT1         ; for far branches
SEDIT6   CMP #KESC
         BNE SEDIT7
         CLC                ; cancelled
         RTS
SEDIT7   CMP #KUP
         BNE SEDIT8
         LDA SFI
         BEQ SEDITJ         ; at the first
         DEC SFI
         JMP SEDIT1
SEDIT8   LDX SFI
         CPX #8
         BCS SEDIT9         ; on the protocol
         INC SFI            ; any other: next
         JMP SEDIT1
SEDIT9   CMP #KRETURN       ; RETURN on the
         BNE SEDITJ         ; protocol saves
;
; To be saved: blanks filled in, the
; line made, and is there room?
;
         LDA SREC+48        ; no port: 21, or
         BNE SEDIT10        ; 22 for SFTP
         LDX #'1
         LDA SREC+SPROTO
         CMP #PROSFTP
         BNE SEDIT9A
         LDX #'2
SEDIT9A  STX SREC+49
         LDA #'2
         STA SREC+48
         LDA #0
         STA SREC+50
SEDIT10  LDA SREC           ; no name: use server
         BNE SEDIT12
         LDX #0
SEDIT11  LDA SREC+16,X      ; server, field 1
         STA SREC,X
         BEQ SEDIT12
         INX
         CPX #15            ; 15 and the 0
         BNE SEDIT11
         LDA #0
         STA SREC,X
SEDIT12  JSR SPACK
         JSR SROOM
         BCS SEDIT13        ; fits: C=1, save
         JSR INFOI
         .BYTE "No room for this site.",0
         JSR KEYGET
         CLC                ; as if ESC
SEDIT13  RTS
;
; SITESCR - the Sites screen
; Exit: A=site to connect to, or NO
;
SITESCR  LDA #0
         STA SCUR
         JSR SFRAME
SITES1   LDA SCUR
         JSR SHLIST
         LDA #<LKEYS
         LDY #>LKEYS
         JSR KEYBAR
         JSR INFOI
         .BYTE "Pick a site. ^G: the Pi gateway",0
         JSR KEYGET
         CMP #KESC
         BNE SITES2
         LDA #NO
         RTS
SITES2   CMP #KUP           ; up or -
         BEQ SITES2A
         CMP #'-
         BNE SITES3
SITES2A  LDA SCUR
         BEQ SITES1         ; at the first
         DEC SCUR
         JMP SITES1
SITES3   CMP #KDOWN         ; down or =
         BEQ SITES3A
         CMP #'=
         BNE SITES4
SITES3A  LDX SCUR
         INX
         CPX SCOUNT
         BCS SITES1         ; at the last
         STX SCUR
         JMP SITES1
SITES4   CMP #KRETURN
         BNE SITES5
         LDA SCOUNT
         BEQ SITES1         ; no sites
         LDA SCUR           ; connect to it
         RTS
SITESJ   JMP SITES1         ; for far branches
SITES5   CMP #14            ; ^N
         BNE SITES7
         LDA SCOUNT
         CMP #MAXSITES
         BNE SITES6
         JSR INFOI
         .BYTE "No room: 8 sites at most.",0
         JSR KEYGET
         JMP SITES1
;
; New: edit an empty site after the
; last; it counts once it is saved
;
SITES6   JSR SHLIST         ; A=SCOUNT: cursor
         LDX SCOUNT         ; on the new one
         JSR SEDIT
         BCC SITESJ         ; cancelled
         LDA SCOUNT
         STA SCUR
         LDA #0             ; BUF, added
         JSR SSAVEUI
         JMP SITES1
SITES7   CMP #5             ; ^E
         BNE SITES8
         LDA SCOUNT
         BEQ SITESJ
         LDX SCUR
         JSR SEDIT
         BCC SITESJ
         LDA #0             ; BUF in its place
         JSR SSAVEUI
         JMP SITES1
SITESK   JMP SITES1         ; for far branches
SITES8   CMP #KDEL
         BEQ SITES8A
         CMP #KDEL2
         BNE SITESG
SITES8A  LDA SCOUNT
         BEQ SITESK
         JSR MSGSTART
         JSR SBI
         .BYTE "Delete ",0
         LDX SCUR
         JSR SSEL
         LDA SITEP
         LDY SITEP+1
         JSR SBADD
         JSR SBI
         .BYTE "? Y/N",0
         JSR INFOMSG
         JSR KEYGET
         AND #$DF           ; upper case
         CMP #'Y
         BNE SITESK
;
; Deleted: written without it, then
; the cursor on the last if it was
; past the end
;
         LDA SCUR
         STA SEDI
         LDA #$80           ; left out
         JSR SSAVEUI
         LDA SCUR
         BEQ SITES11
         CMP SCOUNT
         BCC SITES11
         DEC SCUR           ; was the last
SITES11  JMP SITES1
;
; ^G: the Pi gateway, for SFTP and
; FTPS sites, edited and saved; ESC
; reads it back as it was
;
SITESG   CMP #7
         BNE SITESK
         LDA #GWLEN
         STA EDMAX
         LDA #<GW
         STA ASKB
         LDA #>GW
         STA ASKB+1
         JSR ASKI
         .BYTE "Pi gateway:",0
         BEQ SITESG1        ; ESC
         LDA #$FF           ; no site changed
         STA SEDI
         LDA #0
         JSR SSAVEUI
         JMP SITES1
SITESG1  JSR SLOAD
         JMP SITES1
;
CFG      .BYTE "D:EFTPXL.CFG",0
STITLE   .BYTE "Sites",0
NOTHING  .BYTE 0
;
; SHFLD's labels; the modes and the
; protocols, by number (MODEBIN ...,
; PROFTP ...)
;
LABELS   .BYTE "Name:",0,"Server:",0,"Port:",0,"User:",0,"Password:",0
         .BYTE "Folder:",0,"Atari:",0,"Files:",0,"Protocol:",0
MODES    .BYTE "Binary",0,"Text",0,"By type",0
PROTS    .BYTE "FTP",0,"SFTP",0,"FTPS",0
;
; Key bars: list, then editing
;
LKEYS    .BYTE "RETURN",0,"Connect",0,"^N",0,"New",0,"^E",0,"Edit",0
         .BYTE "DEL",0,"Del",0,0
EKEYS    .BYTE "RETURN",0,"Next",0,"ESC",0,"Cancel",0,0
