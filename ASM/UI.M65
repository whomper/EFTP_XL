;
; UI.M65 - EFTP_XL 1.3
; The main screen and its keys
; Copyright (C) 2026 AERA | Erez Yaary
;
; START - run address: clear the
; variables, draw the screen, read
; the disk, then the key loop
;
START    LDA #<BSS          ; zero BSS..BSSEND
         STA PTR
         LDA #>BSS
         STA PTR+1
         LDY #0
START1   TYA                ; A=Y=0
         STA (PTR),Y
         JSR INCPTR
         LDA PTR+1          ; PTR < BSSEND?
         CMP #>BSSEND
         BCC START1
         LDA PTR            ; high equal: low
         CMP #<BSSEND
         BCC START1
         STY CONN           ; Y=0: ZP ones too
         STY ACTIVE
         STY SINV
         JSR AXSTART        ; RESET: AXWARM
         JSR FTOUT          ; 20 s timeout
         LDA #NO            ; no site yet
         STA SITE
         LDA #1             ; D1:
         JSR LDRIVE
         JSR SCRINIT
         JSR DALL
         JSR SLOAD          ; read the sites
         JSR READLOC
         LDA #LOCAL
         JSR DPANE
         JSR DDETAIL
MAIN     JSR KEYGET         ; main loop
         STA KEY
         LDA ACTIVE
         JSR PUSE
         JSR DISP
         JMP MAIN
;
; AXWARM - RESET, after DOS's own
; init (xl's AXRESET): close N2:
; and N1: (the FujiNet keeps them
; open), then start again, so
; disconnected (AXFONT only sets
; CHBAS again: the font is kept)
;
AXWARM   LDX #$FF           ; a fresh stack
         TXS
         JSR DCLOSE         ; N2:
         LDA #0
         STA CONN
         JSR NCLOSE         ; N1:
         JMP START
;
; DISP - run the routine for KEY;
; it is pushed as address-1, so RTS
; goes to it. X: index into KEYS,
; KEYL and KEYH
;
DISP     LDX #0
DISP1    LDA KEYS,X         ; look it up
         BEQ DISP3          ; not in KEYS
         CMP KEY
         BEQ DISP2
         INX
         BNE DISP1          ; always
DISP2    LDA KEYH,X         ; push routine-1,
         PHA                ; high byte first
         LDA KEYL,X
         PHA
         RTS                ; to the routine
DISP3    LDA KEY            ; 1-8: a drive
         CMP #'1
         BCC DISP4
         CMP #'9
         BCS DISP4
         LDX ACTIVE         ; Atari pane only
         BNE DISP4
         AND #$0F           ; '1'-'8' to 1-8
         JSR LDRIVE
         JSR READLOC
         LDA #LOCAL
         JSR DPANE
         JMP DDETAIL
DISP4    JSR ISALPH         ; letter: to the next
         BCC DISP5          ; name with it
         JMP JUMP
DISP5    RTS
;
; KEYS - the keys, 0 ends: arrows
; and - = + *, TAB, RETURN, BKSP,
; space, ^A ^K ^D ^R, HELP ?, ^Q ^T
; ^N ^E, Shift/Ctrl+Delete
; KEYL/KEYH: routine-1 (RTS adds 1)
;
KEYS     .BYTE KUP,'-,KDOWN,'=,KLEFT,'+,KRIGHT,'*,KTAB,KRETURN,KBKSP,32
         .BYTE 1,11,4,18,KHELP,'?,17,20,14,5,KDEL,KDEL2,0
KEYL     .BYTE <[HUP-1],<[HUP-1],<[HDOWN-1],<[HDOWN-1],<[HPGUP-1]
         .BYTE <[HPGUP-1],<[HPGDN-1],<[HPGDN-1],<[HTAB-1],<[OPENENT-1]
         .BYTE <[GOUP-1],<[HSPACE-1],<[HMALL-1],<[HSITES-1],<[HDISC-1]
         .BYTE <[HREAD-1],<[HELP-1],<[HELP-1],<[HQUIT-1],<[HSEND-1]
         .BYTE <[NEWFOLD-1],<[RENAME-1],<[DELETE-1],<[DELETE-1]
KEYH     .BYTE >[HUP-1],>[HUP-1],>[HDOWN-1],>[HDOWN-1],>[HPGUP-1]
         .BYTE >[HPGUP-1],>[HPGDN-1],>[HPGDN-1],>[HTAB-1],>[OPENENT-1]
         .BYTE >[GOUP-1],>[HSPACE-1],>[HMALL-1],>[HSITES-1],>[HDISC-1]
         .BYTE >[HREAD-1],>[HELP-1],>[HELP-1],>[HQUIT-1],>[HSEND-1]
         .BYTE >[NEWFOLD-1],>[RENAME-1],>[DELETE-1],>[DELETE-1]
;
; The key routines, on the active
; pane (SIDE)
;
HUP      LDX SIDE           ; up a line
         LDA PCUR,X
         BEQ DISP5          ; at the top: RTS
         SEC
         SBC #1
         JMP MOVETO
HDOWN    LDX SIDE           ; down a line
         LDA PCUR,X
         CLC
         ADC #1
         JMP MOVETO         ; stops at the end
HPGUP    LDX SIDE           ; up a page
         LDA PCUR,X
         SEC
         SBC #VIS
         BCS HPGUP1
         LDA #0             ; to the top
HPGUP1   JMP MOVETO
HPGDN    LDX SIDE           ; down a page
         LDA PCUR,X
         CLC
         ADC #VIS
         JMP MOVETO
HTAB     LDA CONNECTD       ; the other pane
         BEQ NOTCONN
         LDA ACTIVE
         EOR #1             ; 0 <-> 1
         STA ACTIVE
         JMP DPANES
NOTCONN  JSR INFOI
         .BYTE "Not connected: ^K picks a site",0
         RTS
HSPACE   LDA #0             ; mark one, move on
         JMP MARK
HMALL    LDA #1             ; mark all or none
         JMP MARK
HSITES   JSR SITESCR        ; A=site, or NO
         PHA                ; keep it over DALL
         JSR DALL
         PLA
         BMI HSITES1        ; NO ($FF): none
         JSR CONNECT
         JMP DPANES         ; keep the info line
HSITES1  RTS
HDISC    JSR DISC
         JMP DALL
HREAD    JSR READLOC        ; read both again
         LDA CONNECTD
         BEQ HREAD1
         JSR READREM
HREAD1   JMP DALL
HQUIT    JSR DISC
         JSR SCRDONE
         JSR AXQUIT         ; DOSINI DOS's again
         JMP (DOSVEC)       ; back to DOS
HSEND    LDA #0             ; marked, or cursor
         JMP SENDF
;
; Drawing the main screen
;
; INFO - A/Y on the info line, then
; the dot in the last column when
; connected; INFOI: string inline
;
INFOI    JSR INLINE         ; A/Y=string, then
INFO     PHA                ; keep A/Y over AT
         TYA
         PHA
         LDX #1             ; row 1
         LDY #SCRL
         JSR AT
         LDA #SCRW-1        ; all but the dot
         STA SW
         PLA                ; A/Y back
         TAY
         PLA
         JSR PUTW
         LDA #32            ; last column: space
         LDX CONNECTD
         BEQ INFO1
         LDA #CHDOT         ; or the dot
INFO1    JMP PUTCH
;
; IDLE - the info line at rest: the
; site's name, or "Not connected"
;
IDLE     LDA CONNECTD
         BEQ IDLE1
         LDX SITE
         JSR SSEL
         LDA SITEP          ; its name: field 0
         LDY SITEP+1
         JMP INFO
IDLE1    JSR INFOI
         .BYTE "Not connected",0
         RTS
;
; INFOMSG - MSG on the info line
; MSGSTART: start a line in MSG
;
INFOMSG  LDA #<MSG
         LDY #>MSG
         JMP INFO
MSGSTART LDA #<MSG
         LDY #>MSG
         JMP SBSTART
;
; DFRAME - rows 2-22: the lines and
; the transfers. The rows:
;  0 title       16 ---+---
;  1 info        17 details
;  2 ---+---     18 - Transfers -
;  3 folders     19-21 transfers
;  4 counts      22 -------
;  5-15 files    23 keys
;
DFRAME   LDX #2             ; clear rows 2-22
DFRAME1  JSR CLRROW
         INX
         CPX #23
         BNE DFRAME1
         LDX #2
         JSR RULE
         LDX #16
         JSR RULE
         LDX #2             ; line between panes
DFRAME2  LDY #DIV
         JSR AT
         LDA #CHVLINE       ; rows 3-15
         CPX #2
         BNE DFRAME3
         LDA #CHTT          ; T at the top
DFRAME3  CPX #16
         BNE DFRAME4
         LDA #CHBT          ; and at the bottom
DFRAME4  JSR PUTCH
         INX
         CPX #17
         BNE DFRAME2
         LDX #XROW
         JSR RULE
         LDX #XROW
         LDY #SCRL+1
         JSR AT
         JSR PUTSI
         .BYTE " Transfers ",0
         LDX #22
         JSR RULE
         JMP XDRAW
;
; DENTRY - entry A of pane SIDE on
; its row: icon, name, size; a
; blank row past the last one
;
DENTRY   STA DEI
         LDX SIDE
         SEC
         SBC PTOP,X         ; row A-PTOP+LISTROW
         CLC
         ADC #LISTROW
         TAX
         LDY SIDE
         LDA COL0,Y         ; the pane's column
         TAY
         JSR AT
         LDX SIDE
         LDA DEI
         CMP PCOUNT,X
         BCC DENT1          ; an entry
         LDA WIDTH,X        ; none: blank
         STA SW
         JMP SPACES
DENT1    LDY #0
         CPX ACTIVE         ; inverse: cursor of
         BNE DENT2          ; the active pane
         CMP PCUR,X
         BNE DENT2
         LDY #$80
DENT2    STY SINV
         CLC
         ADC BASE
         STA DEK            ; DEK=entry, DEF=flags
         TAX
         LDA EFLAG,X
         STA DEF
         LDY #CHUP          ; icon: .. arrow,
         AND #EUP
         BNE DENT3
         LDY #CHMARK        ; marked,
         LDA DEF
         AND #EMARK
         BNE DENT3
         LDY ICFOLD         ; folder,
         LDA DEF
         AND #EDIR
         BNE DENT3
         LDY ICFILE         ; else a file
DENT3    TYA
         JSR PUTCH
; the name; if too long, cut one
; short and end it with CHMORE
         LDA #NAMEW         ; server pane: 1 more
         CLC
         ADC SIDE
         STA SW
         LDX DEK
         JSR ENAME
         JSR STRLEN
         CMP SW             ; len <= SW: fits
         BCC DENT4
         BEQ DENT4
         DEC SW             ; too long: cut it,
         JSR DENTN
         LDA ICMORE         ; then the more mark
         JSR PUTCH
         JMP DENT5
DENT4    JSR DENTN
DENT5    JSR SIZESTART
         LDA DEF
         AND #EDIR+EUP      ; size of files only
         BNE DENT6
         LDX DEK
         JSR ESIZE
         JSR SBSIZE
DENT6    LDA #<SIZEB        ; right in 5 columns
         LDY #>SIZEB
         JSR STRLEN
         EOR #$FF           ; SW = 5-length
         SEC
         ADC #5             ; -len-1 +1 +5
         STA SW
         JSR SPACES
         LDA #<SIZEB
         LDY #>SIZEB
         JSR PUTS
         JMP INVOFF
DENTN    LDX DEK            ; name, SW columns
         JSR ENAME
         JMP PUTW
SIZESTART LDA #<SIZEB       ; SIZEB = ""
         LDY #>SIZEB
         JMP SBSTART
;
; DLIST - the VIS rows of pane SIDE,
; from its top
;
DLIST    LDX SIDE
         LDA PTOP,X
         STA DLI
DLIST1   LDA DLI
         JSR DENTRY
         INC DLI
         LDX SIDE           ; DENTRY changed X
         LDA PTOP,X
         CLC
         ADC #VIS
         CMP DLI            ; PTOP+VIS: done
         BNE DLIST1
         RTS
;
; MARKED - count the marked entries
; of the active pane; MSIZE = their
; size in all
; Exit: A=MCNT, Z=1 if none
;
MARKED   LDA ACTIVE
         JSR PUSE
         LDA #0
         STA MCNT
         STA MSIZE
         STA MSIZE+1
         STA MSIZE+2
         STA MSIZE+3
         JSR PEND
         LDX BASE
MARKED1  CPX TMP4
         BCS MARKED3        ; all seen
         LDA EFLAG,X
         AND #EMARK
         BEQ MARKED2
         INC MCNT
         CLC                ; MSIZE += its size
         LDA MSIZE
         ADC ES0,X
         STA MSIZE
         LDA MSIZE+1
         ADC ES1,X
         STA MSIZE+1
         LDA MSIZE+2
         ADC ES2,X
         STA MSIZE+2
         LDA MSIZE+3
         ADC ES3,X
         STA MSIZE+3
MARKED2  INX
         BNE MARKED1        ; always
MARKED3  LDA MCNT
         RTS
;
; PEND - TMP4 = end of pane SIDE
; (BASE + its count)
;
PEND     LDX SIDE
         LDA BASE
         CLC
         ADC PCOUNT,X
         STA TMP4
         RTS
;
; CURENT - the entry under the
; active pane's cursor
; Exit: A=X=CURK=entry, Y=count,
;       Z=1 if the pane is empty
;
CURENT   LDA ACTIVE
         JSR PUSE
         LDA BASE
         CLC
         ADC PCUR,X
         STA CURK
         TAX
         LDY SIDE
         LDA PCOUNT,Y
         TAY
         PHP                ; Z of the count:
         TXA                ; TXA changes Z
         PLP
         RTS
;
; DDETAIL - the details row: how
; many marked and their size, or
; the cursor's name, size and date
;
DDETAIL  LDX #DETROW
         JSR CLRROW
         LDY #SCRL
         JSR AT
         JSR MARKED
         BEQ DDET1          ; none marked
         JSR MSGSTART
         LDA MCNT
         JSR SBBYTE
         JSR SBI
         .BYTE " marked, ",0
         LDA #<MSIZE
         LDY #>MSIZE
         JSR GETL           ; NUM = MSIZE
         JSR SBSIZE
         JMP DDET5
DDET1    JSR CURENT
         BEQ DDET6          ; empty pane
         LDA EFLAG,X
         AND #EUP
         BEQ DDET2
         JSR PUTSI
         .BYTE "The folder above",0
         RTS
DDET2    JSR ENAME          ; name, 22 at most
         JSR STRLEN
         CMP #22
         BCC DDET3
         LDA #22
DDET3    STA SW
         LDX CURK
         JSR ENAME
         JSR PUTW
         JSR MSGSTART       ; then " size date"
         JSR SBSP
         LDX CURK
         LDA EFLAG,X
         AND #EDIR
         BEQ DDET4
         JSR SBI
         .BYTE "folder",0
         JMP DDET4A
DDET4    JSR ESIZE
         JSR SBSIZE
DDET4A   JSR SBSP
         LDX CURK
         JSR SBSTAMP
         LDA #<MSG          ; only if it fits
         LDY #>MSG
         JSR STRLEN
         CLC
         ADC SCOL
         CMP #SCRR+2        ; ends by column 39?
         BCS DDET6
DDET5    LDA #<MSG
         LDY #>MSG
         JMP PUTS
DDET6    RTS
;
; DPANE - pane A: its folder, its
; counts, its files
;
DPANE    STA DPS
         JSR PUSE
         LDX DPS
         LDA COL0,X         ; DPC column,
         STA DPC
         LDA WIDTH,X        ; DPW width
         STA DPW
         STA SW
         LDX #HEADROW
         LDY DPC
         JSR AT
         LDA DPS
         BEQ DPANE3         ; Atari: always
         LDA CONNECTD
         BNE DPANE3
         JMP DPNOCON        ; server, offline
DPANE3   LDY #0             ; folder: inverse in
         LDA DPS            ; the active pane
         CMP ACTIVE
         BNE DPANE4
         LDY #$80
DPANE4   STY SINV
         LDX DPS
         LDA PATHL,X        ; DPP = its path
         STA DPP
         LDA PATHH,X
         STA DPP+1
; a path longer than w shows its
; end, after CHMORE
         LDY DPP+1
         LDA DPP
         JSR STRLEN         ; A = length n
         CMP DPW            ; w = DPW
         BCC DPANE5
         BEQ DPANE5
         SBC DPW            ; too long (C=1):
         SEC                ; skip n-w+1
         ADC DPP            ; chars of it
         STA DPP
         BCC DPANE4A
         INC DPP+1
DPANE4A  DEC SW             ; ICMORE, then w-1
         LDA ICMORE
         JSR PUTCH
DPANE5   LDA DPP
         LDY DPP+1
         JSR PUTW
         JSR INVOFF
         JSR MSGSTART       ; "2 dirs 5 files"
         LDX DPS
         LDA PDIRS,X
         PHA                ; for SBPLURAL
         JSR SBBYTE
         JSR SBI
         .BYTE " dir",0
         PLA
         JSR SBPLURAL
         JSR SBSP
         LDX DPS
         LDA PFILES,X
         PHA
         JSR SBBYTE
         JSR SBI
         .BYTE " file",0
         PLA
         JSR SBPLURAL
         LDX DPS
         LDA PFULL,X
         BEQ DPANE6
         LDA #'+            ; more than fit
         JSR SBCH
DPANE6   LDX #CNTROW
         LDY DPC
         JSR AT
         LDA DPW
         STA SW
         JSR INFOMSG1
         JMP DLIST
INFOMSG1 LDA #<MSG          ; MSG in SW columns
         LDY #>MSG
         JMP PUTW
;
; DPNOCON - the server pane when
; not connected
;
DPNOCON  LDA #<SERVER
         LDY #>SERVER
         JSR PUTW
         LDX #CNTROW        ; blank the rest
DPANE1   LDY DPC
         JSR AT
         JSR SPACES
         LDX SROW           ; SPACES used X
         INX
         CPX #LISTROW+VIS
         BNE DPANE1
         INC DPC            ; indent 1 column
         LDX #LISTROW+2
         JSR DPAT
         JSR PUTSI
         .BYTE "Not connected.",0
         LDX #LISTROW+4
         JSR DPAT
         JSR PUTSI
         .BYTE "Press ^K to pick",0
         LDX #LISTROW+5
         JSR DPAT
         JSR PUTSI
         .BYTE "a site, or to add",0
         LDX #LISTROW+6
         JSR DPAT
         JSR PUTSI
         .BYTE "one with ^N.",0
         RTS
DPAT     LDY DPC            ; row X, column DPC
         JMP AT
;
; SBPLURAL - add "s" unless A=1
;
SBPLURAL CMP #1
         BEQ SBPL1
         LDA #'s
         JMP SBCH
SBPL1    RTS
;
; DPANES - both panes, the details
;
DPANES   LDA #LOCAL
         JSR DPANE
         LDA #REMOTE
         JSR DPANE
         JMP DDETAIL
;
; DALL - the whole screen
;
DALL     LDX #0             ; title bar, inverse
         LDY #SCRL
         JSR AT
         LDA #SCRW
         STA SW
         JSR INVON
         JSR SPACES
         LDX #0
         LDY #SCRL+1
         JSR AT
         LDA #<VERSION
         LDY #>VERSION
         JSR PUTS
         LDX #0
         LDY #SCRR-13       ; 13 chars, at right
         JSR AT
         JSR PUTSI
         .BYTE "(C) AERA 2026",0
         JSR INVOFF
         JSR IDLE
         JSR DFRAME
         JSR DPANES
         LDA #<MKEYS
         LDY #>MKEYS
         JMP KEYBAR
;
; Reading the panes
;
; REPORT - "what: why" on the info
; line; A/Y=what, FERR=FTP error
; REPORTI: what inline
; Timeout or closed: disconnected
;
REPORTI  JSR INLINE
REPORT   JSR WHAT
         LDA FERR
         CMP #ETIME
         BNE REPORT1
         JSR SBI
         .BYTE "no answer",0
         JMP REPORT2
REPORT1  CMP #ECLOSED
         BNE REPORT3
         JSR SBI
         .BYTE "connection closed",0
REPORT2  LDA #0             ; connection gone
         STA CONNECTD
         JMP INFOMSG
REPORT3  LDA #<FTPMSG       ; the server's reply
         LDY #>FTPMSG
         JSR SBADD
         JMP INFOMSG
;
; WHAT - MSG = A/Y + ": "
;
WHAT     PHA
         TYA
         PHA
         JSR MSGSTART
         PLA
         TAY
         PLA
         JSR SBADD
         JSR SBI
         .BYTE ": ",0
         RTS
;
; READLOC - read the Atari pane; on
; error "PATH0 error N"
;
READLOC  JSR INFOI
         .BYTE "Reading the disk...",0
         JSR LREAD
         BCC READLOC1
         STA FERR           ; CIO status
         JSR MSGSTART
         LDA #<PATH0
         LDY #>PATH0
         JSR SBADD
         JSR SBI
         .BYTE " error ",0
         LDA FERR
         JSR SBBYTE
         JMP INFOMSG
READLOC1 JMP IDLE
;
; READREM - read the server pane; on
; error "List: why"
;
READREM  JSR INFOI
         .BYTE "Reading the server's folder...",0
         JSR RREAD
         BCC READLOC1
         STA FERR
         JSR REPORTI
         .BYTE "List",0
         RTS
;
; FINDN - cursor of pane SIDE on the
; name A/Y, if it is there
;
FINDN    JSR PFIND
         BCS FINDN2         ; not there
         SEC
         SBC BASE           ; pane index
         LDX SIDE
         STA PCUR,X
         LDY #0             ; top 0 if on page 1,
         CMP #VIS
         BCC FINDN1
         SBC #VIS/2         ; else top A-VIS/2,
         TAY                ; cursor mid-way
FINDN1   TYA
         STA PTOP,X
FINDN2   RTS
;
; REREAD - read pane A again, the
; cursor staying on the same name
;
REREAD   STA RRS
         JSR PUSE
         LDA #0             ; UTMP = its name,
         STA UTMP           ; "" if none
         LDX SIDE
         LDA PCOUNT,X
         BEQ REREAD1
         LDA BASE
         CLC
         ADC PCUR,X
         TAX
         JSR ENAME
         JSR TOUTMP
REREAD1  LDA RRS
         BNE REREAD2
         JSR LREAD
         JMP REREAD3
REREAD2  JSR RREAD
REREAD3  LDA RRS            ; errors not shown
         JSR PUSE
         LDA #<UTMP
         LDY #>UTMP
         JMP FINDN
;
; TOUTMP - UTMP = A/Y
;
TOUTMP   LDX #<UTMP
         STX PTR2
         LDX #>UTMP
         STX PTR2+1
         JMP STRCPY
;
; ASK - ask A/Y on the info line and
; edit ASKB after it (EDMAX long)
; ASKI: A/Y inline; ASKTI: inline,
; and ASKB = UTMP
; Exit: A=key, Z=1 if ESC
;
ASKI     JSR INLINE
ASK      STA ASKQ
         STY ASKQ+1
         JSR INFO
         LDA ASKQ           ; edit after it
         LDY ASKQ+1
         JSR STRLEN
         CLC
         ADC #SCRL+1        ; and a space
         TAY
         LDX #1
         JSR AT
         LDA #SCRR          ; up to the dot
         SEC
         SBC SCOL
         STA SW
         LDA ASKB
         LDY ASKB+1
         JSR EDIT
         CMP #KESC          ; Z=1: ESC; A kept
         RTS
ASKTI    JSR INLINE
         LDX #<UTMP         ; ASKB = UTMP
         STX ASKB
         LDX #>UTMP
         STX ASKB+1
         JMP ASK
