         .OPT NO LIST
;
; EFTPXL.M65 - EFTP_XL 1.2
; FTP client for FujiNet
; Copyright (C) 2026 AERA | Erez Yaary
; GPL-2.0-or-later, see COPYING
;
; Mac/65: LOAD #D:EFTPXL.M65, then
; ASM ,,#D:EFTPXL.PRG
;
         .INCLUDE #D:AXEQU.M65
         .INCLUDE #D:EQUATES.M65
;
LOAD     =   $4000      ; above DOS and EDOS
;
; CHECK - init segment, run before
; the program loads: MEMLO must be
; at most LOAD and MEMTOP above
; BSSEND, else say so and go to DOS
; At $9A00: past BSSEND, below the
; screen. DOS runs it (INITAD) as
; soon as it is in, so the rest of
; the file is not yet loaded
;
         *=  $9A00
CHECK    LDA MEMLO+1        ; MEMLO <= $4000?
         CMP #>LOAD
         BCC CHECK1         ; below $4000: fine
         BNE CHECK2         ; $4100 up: too big
         LDA MEMLO          ; $40xx: only $4000
         BNE CHECK2
CHECK1   LDA MEMTOP         ; room up to BSSEND?
         CMP #<BSSEND       ; 16-bit compare:
         LDA MEMTOP+1       ; C=1 if MEMTOP is
         SBC #>BSSEND       ; BSSEND or more
         BCS CHECK3
         LDA #<NOROOM
         LDY #>NOROOM
         BNE CHECK4         ; always
CHECK2   LDA #<LOW          ; DOS too big
         LDY #>LOW
CHECK4   STA ICBAL          ; print it on E:
         STY ICBAH
         LDA #$FF           ; up to 255 bytes,
         STA ICBLL          ; to the EOL
         LDA #0
         STA ICBLH
         LDA #9             ; PUT RECORD
         STA ICCOM
         LDX #0             ; IOCB 0
         JSR CIOV
         JMP (DOSVEC)       ; back to DOS
CHECK3   RTS                ; all well: load on
LOW      .BYTE "EFTP_XL loads at $4000: MEMLO is above it",EOL
NOROOM   .BYTE "EFTP_XL: not enough memory",EOL
         *=  INITAD         ; DOS calls CHECK
         .WORD CHECK
;
; The program; the font first, as
; it must be 1K aligned
;
         *=  LOAD
         .INCLUDE #D:FONT.M65
;
; The last release; every build
; shows it
;
VERSION  .BYTE "EFTP_XL 1.2",0
;
         .INCLUDE #D:UI.M65
         .INCLUDE #D:CMDS.M65
         .INCLUDE #D:XFER.M65
         .INCLUDE #D:XSHOW.M65
         .INCLUDE #D:XTREE.M65
         .INCLUDE #D:SITES.M65
         .INCLUDE #D:FTP.M65
         .INCLUDE #D:REMOTE.M65
         .INCLUDE #D:LOCAL.M65
         .INCLUDE #D:PANE.M65
         .INCLUDE #D:SCREEN.M65
         .INCLUDE #D:TEXT.M65
;
; xl's shared code: RESET back into
; the program, AERA.FNT, the texts
; of CIO's and DOS's errors
;
AXPTR    =   PTR        ; lent to AXERR
AXERRS   =   2          ; CIO's and DOS's
         .INCLUDE #D:AXRESET.M65
         .INCLUDE #D:AXFONT.M65
         .INCLUDE #D:AXERR.M65
         .INCLUDE #D:DATA.M65
;
         *=  RUNAD
         .WORD START
