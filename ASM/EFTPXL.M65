         .OPT NO LIST
;
; EFTPXL.M65 - EFTP_XL 1.3
; FTP client for FujiNet
; Copyright (C) 2026 AERA | Erez Yaary
; GPL-2.0-or-later, see COPYING
;
; Mac/65: LOAD #D:EFTPXL.M65, then
; ASM ,,#D:EFTPXL.PRG
;
         .INCLUDE #D:AXEQU.M65
         .INCLUDE #D:EQUATES.M65
;
LOAD     =   $4000      ; above DOS and EDOS
;
; The load check (xl's AXLOAD): an
; init segment, which DOS runs
; before the rest of the file loads.
; MEMLO must be at most LOAD, and
; MEMTOP at least BSSEND. At $9A00,
; past what the file loads (the font
; may cover it later: it has run by
; then)
;
AXLOW    =   LOAD
AXHIGH   =   BSSEND
         *=  $9A00
AXLOWM   .BYTE "EFTP_XL loads at $4000: MEMLO is above it",EOL
AXROOMM  .BYTE "EFTP_XL: not enough memory",EOL
         .INCLUDE #D:AXLOAD.M65
;
; The program (the font is AERA.FNT,
; read below the screen by AXFONT
; when it is there)
;
         *=  LOAD
;
; The last release; every build
; shows it
;
VERSION  .BYTE "EFTP_XL 1.3",0
;
         .INCLUDE #D:UI.M65
         .INCLUDE #D:CMDS.M65
         .INCLUDE #D:XFER.M65
         .INCLUDE #D:XSHOW.M65
         .INCLUDE #D:XTREE.M65
         .INCLUDE #D:SITES.M65
         .INCLUDE #D:FTP.M65
         .INCLUDE #D:REMOTE.M65
         .INCLUDE #D:LOCAL.M65
         .INCLUDE #D:PANE.M65
         .INCLUDE #D:SCREEN.M65
         .INCLUDE #D:TEXT.M65
;
; xl's shared code: RESET back into
; the program, AERA.FNT, the texts
; of CIO's and DOS's errors
;
AXPTR    =   PTR        ; lent to AXERR
AXERRS   =   2          ; CIO's and DOS's
AXFMIN   =   [BSSEND+255]/256 ; font: above us
         .INCLUDE #D:AXRESET.M65
         .INCLUDE #D:AXFONT.M65
         .INCLUDE #D:AXERR.M65
         .INCLUDE #D:DATA.M65
;
         *=  RUNAD
         .WORD START
